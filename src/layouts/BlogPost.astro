---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { CONTACT_PATH } from '../lib/contact';

interface Props {
	title: string;
	description: string;
	collection: 'blog' | 'proyectos' | 'servicios';
	canonicalPath?: string;
	headingId?: string;
	serviceSlug?: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
}

const { title, description, collection, canonicalPath, headingId, serviceSlug, pubDate, updatedDate, heroImage } = Astro.props;
const labels = { blog: 'Blog técnico', proyectos: 'Proyectos y guías', servicios: 'Servicios' };
const isService = collection === 'servicios';
const collectionPath = '/' + collection + '/';
const contactPath = serviceSlug ? '/?servicio=' + encodeURIComponent(serviceSlug) + '#cotizar' : CONTACT_PATH;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={title + ' | ' + SITE_TITLE}
			description={description}
			image={heroImage}
			canonicalPath={canonicalPath}
			type={isService ? 'website' : 'article'}
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="mx-auto w-full max-w-4xl px-5 pb-14 pt-6 md:px-8 md:pb-20 md:pt-10">
			<nav aria-label="Ruta de navegación">
				<ol class="flex flex-wrap items-center gap-x-2 text-sm text-slate-700">
					<li><a href="/" class="inline-flex min-h-11 items-center text-ea-blue underline underline-offset-4">Inicio</a></li>
					<li aria-hidden="true">/</li>
					<li><a href={collectionPath} class="inline-flex min-h-11 items-center text-ea-blue underline underline-offset-4">{labels[collection]}</a></li>
				</ol>
			</nav>

			<article class="mt-3 rounded-2xl border border-slate-200 bg-white">
				<header class="px-5 py-7 sm:px-9 md:px-12 md:py-10">
					{pubDate && (
						<p class="mb-3 text-sm font-semibold text-ea-blue"><FormattedDate date={pubDate} /></p>
					)}
					<h1 id={headingId} class="text-3xl leading-tight md:text-5xl">{title}</h1>
					{updatedDate && (
						<p class="mt-3 text-sm text-slate-600">Actualizado el <FormattedDate date={updatedDate} /></p>
					)}
				</header>

				{heroImage && (
					<div class="aspect-[2/1] overflow-hidden border-y border-slate-200 bg-slate-100 sm:aspect-[21/9]">
						<Image src={heroImage} alt="" width={960} widths={[360, 640, 960]} sizes="(min-width: 896px) 832px, calc(100vw - 40px)" priority class="h-full w-full object-cover" />
					</div>
				)}

				<div class="mx-auto max-w-[70ch] px-5 py-7 sm:px-9 md:py-10">
					<div class="article-content text-base leading-relaxed text-slate-700 md:text-lg">
						<slot />
					</div>
					<div class="mt-8 flex flex-wrap items-center gap-4 border-t border-slate-200 pt-5">
						<a href={contactPath} class="cal-button-primary min-h-11 text-sm">Solicitar consulta</a>
						<a href={collectionPath} class="inline-flex min-h-11 items-center text-sm font-semibold text-ea-blue underline underline-offset-4">Volver a {labels[collection].toLowerCase()}</a>
						{!isService && <a href="/servicios/" class="inline-flex min-h-11 items-center text-sm font-semibold text-ea-blue underline underline-offset-4">Ver servicios</a>}
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-content { overflow-wrap: anywhere; }
	.article-content :global(p) { margin-block: 1rem; }
	.article-content :global(> :first-child) { margin-block-start: 0; }
	.article-content :global(h2), .article-content :global(h3) {
		margin-block: 1.75em 0.4em;
		color: var(--color-brand-midnight);
		line-height: 1.25;
	}
	.article-content :global(h2) { font-size: 1.5rem; }
	.article-content :global(h3) { font-size: 1.25rem; }
	.article-content :global(ul), .article-content :global(ol) {
		margin-block: 1rem;
		padding-inline-start: 1.5rem;
	}
	.article-content :global(ul) { list-style: disc; }
	.article-content :global(ol) { list-style: decimal; }
	.article-content :global(li + li) { margin-block-start: 0.25rem; }
	.article-content :global(a) {
		color: var(--color-ea-blue);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.article-content :global(hr) {
		margin-block: 1.75rem;
		border-color: #e2e8f0;
	}
	.article-content :global(blockquote), .article-content :global(pre) {
		margin-block: 1.5rem;
		border-radius: 0.75rem;
		background-color: #f1f5f9;
		padding: 1rem;
	}
	.article-content :global(pre) { overflow-x: auto; }
</style>
