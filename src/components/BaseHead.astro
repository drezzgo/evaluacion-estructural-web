---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import CalSans from '../assets/fonts/CalSans-SemiBold.woff2?url';
import { SITE_TITLE } from '../consts';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	canonicalPath?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	noindex?: boolean;
}

const { title, description, image, canonicalPath, type = 'website', publishedTime, modifiedTime, noindex } = Astro.props;
const pathname = canonicalPath ?? Astro.url.pathname.replace(/\/?$/, '/');
const canonicalURL = new URL(pathname, Astro.site);
const imageURL = new URL(image?.src ?? '/social-card.png', canonicalURL);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', canonicalURL.origin)} />

<link rel="preload" href={CalSans} as="font" type="font/woff2" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<ClientRouter />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:locale" content="es_CO" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content={String(image?.width ?? 1200)} />
<meta property="og:image:height" content={String(image?.height ?? 630)} />
{!image && <meta property="og:image:alt" content={SITE_TITLE} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
{!image && <meta name="twitter:image:alt" content={SITE_TITLE} />}

<Analytics />
