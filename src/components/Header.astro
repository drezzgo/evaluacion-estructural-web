---
import { SITE_TITLE } from '../consts';
import { CONTACT_PATH } from '../lib/contact';
import HeaderLink from './HeaderLink.astro';

const links = [
	{ href: '/', label: 'Inicio' },
	{ href: '/servicios/', label: 'Servicios' },
	{ href: '/proyectos/', label: 'Proyectos' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/about/', label: 'Nosotros' },
];
---

<a class="skip-link" href="#main-content">Saltar al contenido</a>
<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white">
	<div class="mx-auto flex min-h-16 max-w-300 items-center justify-between gap-4 px-5 md:px-8">
		<a href="/" class="flex min-w-0 items-center gap-2.5 py-2 text-sm font-bold text-brand-midnight hover:text-ea-blue sm:text-base">
			<img src="/favicon.svg" alt="" width="44" height="44" class="h-10 w-10 shrink-0 sm:h-11 sm:w-11" />
			<span class="leading-tight">
				<span translate="no">{SITE_TITLE}</span>
				<span class="mt-0.5 hidden text-xs font-normal text-brand-gray-mid sm:block">Bogotá, Colombia</span>
			</span>
		</a>

		<nav aria-label="Navegación principal" class="hidden items-center gap-1 lg:flex">
			{links.map(({ href, label }) => <HeaderLink href={href}>{label}</HeaderLink>)}
		</nav>

		<a href={CONTACT_PATH} class="hidden min-h-11 shrink-0 items-center rounded-full bg-ea-blue px-5 text-sm font-semibold text-white hover:bg-[#0f5c8d] lg:inline-flex">
			Solicitar consulta
		</a>

		<details data-mobile-menu class="shrink-0 lg:hidden">
			<summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg px-2.5 text-sm font-semibold text-brand-midnight hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M4 6h16M4 12h16M4 18h16" />
				</svg>
				Menú
			</summary>
			<nav aria-label="Navegación principal" class="absolute inset-x-0 top-full grid max-h-[calc(100dvh-4rem)] gap-1 overflow-y-auto border-y border-slate-200 bg-white p-5 shadow-md">
				{links.map(({ href, label }) => <HeaderLink href={href}>{label}</HeaderLink>)}
				<a href={CONTACT_PATH} class="mt-2 flex min-h-11 items-center justify-center rounded-xl bg-ea-blue px-4 py-2 text-sm font-semibold text-white hover:bg-[#0f5c8d]">
					Solicitar consulta
				</a>
			</nav>
		</details>
	</div>
</header>

<script>
	function closeMenu(event: MouseEvent | KeyboardEvent | FocusEvent) {
		const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu][open]');
		if (!menu || !(event.target instanceof Element)) return;

		if (event instanceof KeyboardEvent) {
			if (event.key !== 'Escape' || !menu.contains(event.target)) return;
			menu.querySelector('summary')?.focus();
		} else if (event.type === 'focusin' && menu.contains(event.target)) {
			return;
		} else if (event.type === 'click' && menu.contains(event.target)) {
			const link = event.target.closest('a');
			if (!link) return;
			// Keep focus in the current document when a menu link jumps to its contact section.
			if (link.pathname === location.pathname && link.hash) {
				document.getElementById(link.hash.slice(1))?.focus({ preventScroll: true });
			}
		}

		menu.open = false;
	}

	document.addEventListener('click', closeMenu);
	document.addEventListener('keydown', closeMenu);
	document.addEventListener('focusin', closeMenu);
</script>
