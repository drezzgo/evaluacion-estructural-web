---
import { SITE_TITLE } from '../consts';
import { CONTACT_PATH } from '../lib/contact';
const today = new Date();
---

<footer class="border-t border-slate-200 bg-[#fbfdfd] px-5 py-10 md:px-8 md:py-12">
	<div class="mx-auto flex max-w-300 flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
		<div class="flex items-center gap-3">
			<img src="/favicon.svg" alt="" width="40" height="40" class="h-10 w-10 shrink-0" />
			<div>
				<p class="font-display font-semibold text-brand-midnight" translate="no">{SITE_TITLE}</p>
				<p class="mt-1 text-sm text-brand-gray-mid">© {today.getFullYear()} Todos los derechos reservados.</p>
			</div>
		</div>

		<nav aria-label="Navegación del pie" class="flex flex-wrap gap-x-5 text-sm font-medium text-slate-700">
			<a href="/" class="flex min-h-11 items-center hover:text-ea-blue hover:underline">Inicio</a>
			<a href="/servicios/" class="flex min-h-11 items-center hover:text-ea-blue hover:underline">Servicios</a>
			<a href="/proyectos/" class="flex min-h-11 items-center hover:text-ea-blue hover:underline">Proyectos</a>
			<a href="/blog/" class="flex min-h-11 items-center hover:text-ea-blue hover:underline">Blog</a>
			<a href="/about/" class="flex min-h-11 items-center hover:text-ea-blue hover:underline">Nosotros</a>
			<a href={CONTACT_PATH} class="flex min-h-11 items-center hover:text-ea-blue hover:underline">Contacto</a>
		</nav>
	</div>
</footer>
