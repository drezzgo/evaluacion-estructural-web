---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={'Prototipo | ' + SITE_TITLE} description="Página de prototipo de Evaluación Estructural SAS." noindex />
	</head>
	<body class="flex min-h-screen flex-col">
		<Header />
		<main id="main-content" tabindex="-1" class="mx-auto w-full max-w-300 flex-1 px-5 py-14 md:px-8">
			<h1 class="text-3xl md:text-4xl">Prototipo</h1>
			<p class="mt-3 text-base text-slate-700">Esta página está en preparación.</p>
			<a href="/" class="cal-button-secondary mt-5 min-h-11 text-sm">Volver al inicio</a>
		</main>
		<Footer />
	</body>
</html>
