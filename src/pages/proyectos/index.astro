---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('proyectos')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Proyectos y guías técnicas | ${SITE_TITLE}`} description="Guías de Evaluación Estructural SAS sobre estudios estructurales, evaluación de edificaciones y señales de alerta en muros." />


	</head>
	<body class="antialiased bg-white text-brand-charcoal">
		<Header />

		<main id="main-content" tabindex="-1" class="w-full">

			<!-- Blueprint Subheader -->
			<section class="relative overflow-hidden py-10 sm:py-14 md:py-18 flex flex-col items-center text-center px-6">
				<div class="absolute inset-0 blueprint-grid opacity-50 pointer-events-none [mask-image:radial-gradient(ellipse_at_center,black_60%,transparent_100%)]"></div>

				<div class="relative z-10 max-w-300 mx-auto">
					<h1 class="text-4xl md:text-5xl text-brand-midnight mb-4 tracking-tight font-display">
						Proyectos y guías técnicas
					</h1>
					<p class="text-base md:text-lg text-slate-700 max-w-2xl mx-auto">
						Guías sobre evaluación de edificaciones, estudios estructurales y señales de alerta en muros.
					</p>
				</div>
			</section>

			<!-- Projects Grid -->
			<section class="max-w-300 mx-auto px-6 pb-24">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{
						posts.map((post, index) => (
							<div class:list={[index === 0 && "md:col-span-2"]}>
								<a href={`/proyectos/${post.id}/`} class="group block h-full overflow-hidden rounded-2xl border border-slate-200 bg-white hover:border-ea-blue/45">
									{post.data.heroImage && (
										<div class="aspect-[2/1] overflow-hidden border-b border-slate-200">
											<Image
												width={index === 0 ? 1200 : 720}
												height={index === 0 ? 600 : 360}
												src={post.data.heroImage}
												alt=""
												widths={[360, 640, 960]}
												sizes={index === 0 ? "(min-width: 1200px) 1152px, calc(100vw - 48px)" : "(min-width: 768px) 46vw, calc(100vw - 48px)"}
												priority={index === 0}
												class="w-full h-full object-cover"
											/>
										</div>
									)}
									<div class="p-6 md:p-8">
										<h2 class:list={[
											"text-brand-midnight leading-tight group-hover:text-ea-blue transition-colors mb-3 tracking-tight",
											index === 0 ? "text-3xl md:text-4xl font-display" : "text-2xl"
										]}>
											{post.data.title}
										</h2>
										<p class="max-w-[68ch] text-slate-700 text-base leading-relaxed">
											{post.data.description}
										</p>
										<span class="text-xs font-bold text-ea-blue group-hover:text-[#0f5c8d] inline-flex items-center gap-1 mt-4 transition-colors uppercase tracking-wider">
											Leer guía de estudio
											<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
										</span>
									</div>
								</a>
							</div>
						))
					}
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>
