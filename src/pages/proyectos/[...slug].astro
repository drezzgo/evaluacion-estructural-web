---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { projectCanonical } from '../../lib/project-canonicals.mjs';

export async function getStaticPaths() {
	const posts = await getCollection('proyectos');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'proyectos'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} collection="proyectos" canonicalPath={projectCanonical(post.id)}>
	<Content />
</BlogPost>
